# Copy to .env and fill in. Never commit real secrets.
APP_NAME=AI Intake Automation Platform
APP_ENV=development
LOG_LEVEL=INFO

# Required for POST /api/v1/intake, PATCH, and GET /api/v1/leads
API_KEY=change-me-to-a-long-random-string

# SQLite for local/demo. Postgres example:
# DATABASE_URL=postgresql+psycopg://intake:intake@localhost:5432/intake
DATABASE_URL=sqlite:///./data/intake.db

# ollama | openai
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=3

# Optional. If empty, high-value leads are logged instead of posted.
SLACK_WEBHOOK_URL=

# Optional SMTP. Skipped when SMTP_HOST / SMTP_TO / SMTP_FROM are empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

HIGH_VALUE_SCORE=80
SALES_QUEUE_SCORE=50
